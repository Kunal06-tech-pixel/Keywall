:80 {
  encode zstd gzip

  @api path /v1/* /health/*
  handle @api {
    reverse_proxy api:3001
  }

  handle {
    root * /srv
    header {
      Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' https://fonts.googleapis.com https://db.onlinewebfonts.com; font-src 'self' https://fonts.gstatic.com https://db.onlinewebfonts.com; img-src 'self' data: blob:; media-src 'self' https://d8j0ntlcm91z4.cloudfront.net; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types default"
      Referrer-Policy "no-referrer"
      Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
      X-Content-Type-Options "nosniff"
      Cross-Origin-Opener-Policy "same-origin"
      Cross-Origin-Embedder-Policy "require-corp"
      Cross-Origin-Resource-Policy "same-origin"
      X-Frame-Options "DENY"
    }
    @javascript path_regexp js \.m?js$
    header @javascript Content-Type "application/javascript; charset=utf-8"
    @html path / /index.html
    header @html Cache-Control "no-store"
    try_files {path} /index.html
    file_server
  }
}
